# Copy this file to .env and adjust. Never commit .env.

# ---------- LLM ----------
# "ollama" (default, local, free - same as the original project)
# "groq"   (free hosted API - used for the cloud deployment, see DEPLOY.md)
# "openai" (OpenAI, or any OpenAI-compatible API via LLM_BASE_URL)
LLM_PROVIDER=ollama
# Only needed for LLM_PROVIDER=groq / STT_PROVIDER=groq (free key: https://console.groq.com/keys)
GROQ_API_KEY=
# Optional overrides for hosted models (Groq defaults: openai/gpt-oss-20b, effort "low")
# LLM_MODEL=openai/gpt-oss-20b
# LLM_REASONING_EFFORT=low
OLLAMA_MODEL=llama3
OLLAMA_BASE_URL=http://localhost:11434
# Only needed if any provider below is "openai":
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0
# Time limit per AI request. Default: 600 s for Ollama (a CPU can queue requests),
# 120 s for hosted APIs. Uncomment only to override.
# LLM_TIMEOUT_SECONDS=600
LLM_MAX_RETRIES=2
LLM_SEED=42
# Ollama's default context is 2048 tokens and silently cuts long prompts. Keep 8192.
OLLAMA_NUM_CTX=8192
# Schema-enforced JSON for scoring (recommended)
LLM_STRUCTURED_OUTPUT=true
# ---------- Speed ----------
# Keep llama3 loaded between calls (default Ollama unloads after 5 idle minutes; reload = 10-30 s)
OLLAMA_KEEP_ALIVE=30m
# Maximum output length (tokens) per kind of call. Defaults are small for Ollama (writing
# tokens is slow on a CPU) and larger for hosted models (they "think" first). Uncomment
# only to override.
# LLM_MAX_TOKENS_PARSE=350
# LLM_MAX_TOKENS_SCREEN=300
# LLM_MAX_TOKENS_QUESTION=400
# LLM_MAX_TOKENS_EVAL=450
# LLM_MAX_TOKENS_REPORT=500
# Score answers in the background while the candidate answers the next question
EVAL_IN_BACKGROUND=true
# Answers scored at once at the end (only truly parallel if the Ollama server runs
# with OLLAMA_NUM_PARALLEL=2 or more)
EVAL_MAX_WORKERS=1

# ---------- Interview ----------
MAX_INTERVIEW_QUESTIONS=5
INTERVIEW_QUESTIONS_MIN=3
INTERVIEW_QUESTIONS_MAX=10
INTERVIEW_START_DIFFICULTY=medium
SCREENING_PASS_SCORE=60
ADAPT_HARDER_AT=8
ADAPT_EASIER_BELOW=5
STRONG_HIRE_MIN=8
HIRE_MIN=6.5
CONSIDER_MIN=5

# ---------- Speech-to-text ----------
# "faster_whisper" (default, local, no key), "groq" (free API, uses GROQ_API_KEY) or "openai"
STT_PROVIDER=faster_whisper
# Optional backup if the first provider fails: "" or "openai" (needs OPENAI_API_KEY)
STT_FALLBACK_PROVIDER=
STT_LANGUAGE=en
# tiny.en / base.en / small.en / medium.en / distil-large-v3 - bigger = more accurate, slower.
# small.en (default) handles Indian-accented and technical English much better than base.en.
WHISPER_MODEL_SIZE=small.en
# If huggingface.co is blocked on your network: download the model folder elsewhere
# (e.g. Systran/faster-whisper-small.en) and point to it here.
WHISPER_MODEL_PATH=
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# 1 = fastest (about 2x faster than 5, tiny accuracy cost on clear speech); 5 = most accurate
WHISPER_BEAM_SIZE=1
# CPU threads for speech recognition (set to your number of CPU cores)
WHISPER_CPU_THREADS=8
# Give the question to Whisper as context so technical words are spelled right
STT_USE_QUESTION_CONTEXT=true
# Below this confidence (0-1) the candidate is asked to check the transcript
STT_LOW_CONFIDENCE=0.55
OPENAI_STT_MODEL=whisper-1

# ---------- Text-to-speech ----------
# "edge" (default, no key), "gtts" (no key) or "openai"
TTS_PROVIDER=edge
TTS_FALLBACK_TO_GTTS=true
# Other voices: en-GB-RyanNeural, en-IN-NeerjaNeural, en-IN-PrabhatNeural, en-US-GuyNeural
EDGE_TTS_VOICE=en-US-AriaNeural
EDGE_TTS_RATE=+0%
GTTS_LANG=en
GTTS_TLD=com
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy
VOICE_REQUEST_TIMEOUT_SECONDS=60

# ---------- Recording ----------
MIN_RECORDING_SECONDS=1
MAX_RECORDING_SECONDS=300
SILENCE_RMS_THRESHOLD=20

# ---------- Access ----------
# When set, the app asks for this password first. Recommended for a public link.
APP_PASSWORD=

# ---------- UI ----------
AUTOPLAY_QUESTIONS=true
SHOW_SCORES_TO_CANDIDATE=true
ALLOW_TEXT_ANSWERS=true
LOG_LEVEL=INFO

# ---------- Proctoring (camera + fullscreen) ----------
# Runs in the candidate's browser with Google MediaPipe; no video is uploaded or stored.
PROCTORING_ENABLED=true
# The Nth camera warning ends the interview. Leaving fullscreen / switching tab or
# window / reloading the page always ends it immediately.
PROCTOR_MAX_VIOLATIONS=3
# How long (seconds) each problem must last before it counts as a warning
PROCTOR_NO_FACE_SECONDS=3
PROCTOR_MULTI_FACE_SECONDS=2
PROCTOR_LOOK_AWAY_SECONDS=4
PROCTOR_FACE_COVER_SECONDS=4
# Head angle (degrees) that counts as looking away
PROCTOR_YAW_DEGREES=35
PROCTOR_PITCH_DEGREES=25
# Minimum gap between warnings, and repeat interval if a problem continues
PROCTOR_COOLDOWN_SECONDS=8
PROCTOR_REPEAT_SECONDS=15
# Window focus can be lost this long (e.g. a system popup) before it ends the interview
PROCTOR_FOCUS_GRACE_SECONDS=1.5
# After a technical problem is fixed, seconds the candidate has to return to fullscreen
PROCTOR_RETURN_SECONDS=60
# Model locations. If your network blocks these, download the files into
# proctor_component/assets/ and set e.g. PROCTOR_FACE_MODEL_URL=assets/face_landmarker.task
PROCTOR_MEDIAPIPE_BUNDLE=https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@0.10.14/vision_bundle.mjs
PROCTOR_MEDIAPIPE_WASM=https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@0.10.14/wasm
PROCTOR_FACE_MODEL_URL=https://storage.googleapis.com/mediapipe-models/face_landmarker/face_landmarker/float16/1/face_landmarker.task
PROCTOR_HAND_MODEL_URL=https://storage.googleapis.com/mediapipe-models/hand_landmarker/hand_landmarker/float16/1/hand_landmarker.task
